# Mise loads this file for dev, live and benchmark,
# with output redaction.
# The Go application itself does not parse dotenv files.
NEAR_AI_API_KEY=
PROXY_API_KEY=

# Optional development settings.
# LISTEN_ADDR=127.0.0.1:8080
# No default inference deadline; opt in with a duration such as 30m.
# REQUEST_TIMEOUT=0
# Omitted or 0 uses the SDK's 64 MiB body capacity. Raise for larger bodies.
# MAX_BODY_BYTES=0
